terraform {
  required_version = ">= 1.0"
  required_providers {
    docker = {
      source  = "kreuzwerker/docker"
      version = "~> 3.0"
    }
    null = {
      source  = "hashicorp/null"
      version = "~> 3.0"
    }
  }
}

# For Linux/WSL environment - use Unix socket
provider "docker" {
  host = "unix:///var/run/docker.sock"
}